{
  "name": "ai-workspace-kit",
  "version": "0.1.0",
  "description": "Portable rules, skills, templates and checks that make an AI coding assistant (Claude Code, Cursor, Codex, OpenCode, Cline) work like a careful engineer. Install with npx, then run the setup prompt.",
  "type": "module",
  "license": "MIT",
  "author": "Jakub Owczarzak",
  "keywords": [
    "ai",
    "claude-code",
    "cursor",
    "codex",
    "opencode",
    "cline",
    "agents-md",
    "skills",
    "workflow",
    "sdlc"
  ],
  "homepage": "https://github.com/Jakub-Owczarzak/workspace-kit#readme",
  "bugs": { "url": "https://github.com/Jakub-Owczarzak/workspace-kit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/Jakub-Owczarzak/workspace-kit.git" },
  "bin": { "ai-workspace-kit": "bin/cli.mjs" },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "rules/",
    "templates/",
    "adapters/",
    "stacks/",
    "docs/",
    "catalog/",
    "!**/*.test.mjs"
  ],
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  }
}
